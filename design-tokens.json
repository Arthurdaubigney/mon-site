        "$value": "#1C3D6E"
      },
      "200": {
        "$type": "color",
        "$value": "#C2CCDB"
      }
    },
    "gold": {
      "700": {
        "$type": "color",
        "$value": "#8A6A1E"
      },
      "600": {
        "$type": "color",
        "$value": "#B38D35"
      },
      "500": {
        "$type": "color",
        "$value": "#C9A24A"
      },
      "400": {
        "$type": "color",
        "$value": "#D6B66A"
      },
      "300": {
        "$type": "color",
        "$value": "#E2C687"
      }
    },
    "night": {
      "1000": {
        "$type": "color",
        "$value": "#070D18"
      },
      "950": {
        "$type": "color",
        "$value": "#0B111A"
      },
      "925": {
        "$type": "color",
        "$value": "#0F1620"
      },
      "900": {
        "$type": "color",
        "$value": "#121A26"
      },
      "800": {
        "$type": "color",
        "$value": "#263142"
      },
      "500": {
        "$type": "color",
        "$value": "#7F8A99"
      },
      "400": {
        "$type": "color",
        "$value": "#97A1AE"
      },
      "300": {
        "$type": "color",
        "$value": "#C3CAD4"
      },
      "100": {
        "$type": "color",
        "$value": "#F1F3F6"
      }
    },
    "danger": {
      "700": {
        "$type": "color",
        "$value": "#A12622"
      },
      "300": {
        "$type": "color",
        "$value": "#F2A39B"
      }
    },
    "success": {
      "700": {
        "$type": "color",
        "$value": "#2F6246"
      },
      "300": {
        "$type": "color",
        "$value": "#9ED0B2"
      }
    }
  },
  "semantic": {
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{primitive.neutral.0}",
        "$description": "Fond de page, blanc"
      },
      "card": {
        "$type": "color",
        "$value": "{primitive.neutral.0}",
        "$description": "Cartes et formulaire"
      },
      "band": {
        "$type": "color",
        "$value": "{primitive.neutral.50}",
        "$description": "Bandeau gris froid"
      },
      "deep": {
        "$type": "color",
        "$value": "{primitive.navy.900}",
        "$description": "Bandeaux forts, haut de page et pied de page : bleu nuit"
      },
      "deeper": {
        "$type": "color",
        "$value": "{primitive.navy.950}",
        "$description": "Pied de page, un ton sous le bleu nuit"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.neutral.950}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.neutral.750}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.neutral.600}",
        "$description": "Metadonnees uniquement"
      },
      "link": {
        "$type": "color",
        "$value": "{primitive.navy.700}"
      },
      "accent": {
        "$type": "color",
        "$value": "{primitive.gold.700}",
        "$description": "Surtitres et chiffres sur fond clair (or lisible, 5:1)"
      },
      "on-action": {
        "$type": "color",
        "$value": "{primitive.navy.950}"
      },
      "on-deep": {
        "$type": "color",
        "$value": "{primitive.neutral.0}"
      },
      "on-deep-muted": {
        "$type": "color",
        "$value": "{primitive.navy.200}"
      },
      "ornament": {
        "$type": "color",
        "$value": "{primitive.gold.400}",
        "$description": "Or sur fond bleu nuit uniquement"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.gold.500}"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{primitive.gold.600}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{primitive.neutral.150}",
        "$description": "Decoratif : separateurs, bords de carte"
      },
      "strong": {
        "$type": "color",
        "$value": "{primitive.neutral.500}",
        "$description": "Bord essentiel des champs (>= 3:1)"
      }
    },
    "feedback": {
      "error-text": {
        "$type": "color",
        "$value": "{primitive.danger.700}"
      },
      "success-text": {
        "$type": "color",
        "$value": "{primitive.success.700}"
      }
    }
  },
  "system": {
    "$description": "Tokens non colores, emis tels quels en variables CSS (--radius-*, --shadow-*, --duration-*, --ease-*, --size-*)",
    "radius": {
      "frame": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Photos : angle net, comme un encadrement"
      },
      "control": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Boutons, champs : angles nets, registre maison de ventes"
      },
      "card": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Panneaux et formulaire"
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$description": "Etiquettes"
      },
      "arch": {
        "$type": "dimension",
        "$value": "999px 999px 0 0",
        "$description": "Arc outrepasse marocain : haut en plein cintre pour les photos d'en-tete"
      }
    },
    "shadow": {
      "raised": {
        "$type": "shadow",
        "$value": "0 1px 2px rgb(14 23 38 / 0.06), 0 8px 24px rgb(14 23 38 / 0.08)"
      },
      "overlay": {
        "$type": "shadow",
        "$value": "0 16px 48px rgb(14 23 38 / 0.22)"
      }
    },
    "scrim": {
      "photo": {
        "$type": "gradient",
        "$value": "linear-gradient(to top, rgb(7 13 24 / 0.86) 0%, rgb(7 13 24 / 0.38) 45%, rgb(7 13 24 / 0) 75%)",
        "$description": "Voile sous le texte pose sur une photo (lisibilite >= 4.5:1)"
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "220ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "500ms",
        "$description": "Zoom doux des photos au survol"
      },
      "spin": {
        "$type": "duration",
        "$value": "800ms",
        "$description": "Rotation de l'indicateur de chargement"
      }
    },
    "ease": {
      "out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "in-out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
      }
    },
    "size": {
      "header": {
        "$type": "dimension",
        "$value": "5rem",
        "$description": "Hauteur de la barre principale collante ; sert aussi au scroll-padding (WCAG 2.4.11)"
      },
      "focus-ring": {
        "$type": "dimension",
        "$value": "3px"
      },
      "border-control": {
        "$type": "dimension",
        "$value": "1px",
        "$description": "Epaisseur du bord des boutons"
      }
    }
  },
  "dark": {
    "$description": "Surcharges semantiques du mode sombre",
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{primitive.night.950}"
      },
      "card": {
        "$type": "color",
        "$value": "{primitive.night.900}"
      },
      "band": {
