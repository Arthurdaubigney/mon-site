      },
      "500": {
        "$type": "color",
        "$value": "#C9A24A"
      },
      "400": {
        "$type": "color",
        "$value": "#D6B66A"
      },
      "300": {
        "$type": "color",
        "$value": "#E2C687"
      }
    },
    "night": {
      "1000": {
        "$type": "color",
        "$value": "#120706"
      },
      "950": {
        "$type": "color",
        "$value": "#170D0B"
      },
      "925": {
        "$type": "color",
        "$value": "#1D110E"
      },
      "900": {
        "$type": "color",
        "$value": "#231512"
      },
      "800": {
        "$type": "color",
        "$value": "#3A2722"
      },
      "500": {
        "$type": "color",
        "$value": "#8F7F78"
      },
      "400": {
        "$type": "color",
        "$value": "#A99A93"
      },
      "300": {
        "$type": "color",
        "$value": "#D2C6C0"
      },
      "100": {
        "$type": "color",
        "$value": "#F5EFEC"
      }
    },
    "danger": {
      "700": {
        "$type": "color",
        "$value": "#A12622"
      },
      "300": {
        "$type": "color",
        "$value": "#F2A39B"
      }
    },
    "success": {
      "700": {
        "$type": "color",
        "$value": "#2F6246"
      },
      "300": {
        "$type": "color",
        "$value": "#9ED0B2"
      }
    },
    "rouge": {
      "975": {
        "$type": "color",
        "$value": "#3A0A08"
      },
      "900": {
        "$type": "color",
        "$value": "#8B1E1A"
      },
      "800": {
        "$type": "color",
        "$value": "#8E1B16"
      },
      "dark": {
        "$type": "color",
        "$value": "#4A100D"
      },
      "100": {
        "$type": "color",
        "$value": "#EAD9C9"
      }
    },
    "brun": {
      "950": {
        "$type": "color",
        "$value": "#1F1210"
      }
    }
  },
  "semantic": {
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{primitive.neutral.0}",
        "$description": "Fond de page, blanc"
      },
      "card": {
        "$type": "color",
        "$value": "{primitive.neutral.0}",
        "$description": "Cartes et formulaire"
      },
      "band": {
        "$type": "color",
        "$value": "{primitive.neutral.50}",
        "$description": "Bandeau gris froid"
      },
      "deep": {
        "$type": "color",
        "$value": "{primitive.rouge.900}",
        "$description": "Bandeaux forts (haut de page, etapes, appel a l'action) : rouge marocain"
      },
      "deeper": {
        "$type": "color",
        "$value": "{primitive.brun.950}",
        "$description": "Bandeau superieur et pied de page : brun tres fonce, nettement distinct du rouge des bandeaux"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.neutral.950}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.neutral.750}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.neutral.600}",
        "$description": "Metadonnees uniquement"
      },
      "link": {
        "$type": "color",
        "$value": "{primitive.rouge.800}"
      },
      "accent": {
        "$type": "color",
        "$value": "{primitive.gold.700}",
        "$description": "Surtitres et chiffres sur fond clair (or lisible, 5:1)"
      },
      "on-action": {
        "$type": "color",
        "$value": "{primitive.rouge.975}"
      },
      "on-deep": {
        "$type": "color",
        "$value": "{primitive.neutral.0}"
      },
      "on-deep-muted": {
        "$type": "color",
        "$value": "{primitive.rouge.100}"
      },
      "ornament": {
        "$type": "color",
        "$value": "{primitive.gold.300}",
        "$description": "Or sur fond rouge uniquement"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.gold.500}"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{primitive.gold.600}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{primitive.neutral.150}",
        "$description": "Decoratif : separateurs, bords de carte"
      },
      "strong": {
        "$type": "color",
        "$value": "{primitive.neutral.500}",
        "$description": "Bord essentiel des champs (>= 3:1)"
      }
    },
    "feedback": {
      "error-text": {
        "$type": "color",
        "$value": "{primitive.danger.700}"
      },
      "success-text": {
        "$type": "color",
        "$value": "{primitive.success.700}"
      }
    }
  },
  "system": {
    "$description": "Tokens non colores, emis tels quels en variables CSS (--radius-*, --shadow-*, --duration-*, --ease-*, --size-*)",
    "radius": {
      "frame": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Photos : angle net, comme un encadrement"
      },
      "control": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Boutons, champs : angles nets, registre maison de ventes"
      },
      "card": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Panneaux et formulaire"
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$description": "Etiquettes"
      },
      "arch": {
        "$type": "dimension",
        "$value": "999px 999px 0 0",
        "$description": "Arc outrepasse marocain : haut en plein cintre pour les photos d'en-tete"
      }
    },
    "shadow": {
      "raised": {
        "$type": "shadow",
        "$value": "0 1px 2px rgb(30 21 18 / 0.06), 0 8px 24px rgb(30 21 18 / 0.08)"
      },
      "overlay": {
        "$type": "shadow",
        "$value": "0 16px 48px rgb(30 21 18 / 0.22)"
      }
    },
    "scrim": {
      "photo": {
        "$type": "gradient",
        "$value": "linear-gradient(to top, rgb(18 7 6 / 0.86) 0%, rgb(18 7 6 / 0.38) 45%, rgb(18 7 6 / 0) 75%)",
        "$description": "Voile sous le texte pose sur une photo (lisibilite >= 4.5:1)"
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "220ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "500ms",
        "$description": "Zoom doux des photos au survol"
      },
      "spin": {
        "$type": "duration",
        "$value": "800ms",
        "$description": "Rotation de l'indicateur de chargement"
      }
    },
    "ease": {
      "out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "in-out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
      }
    },
    "size": {
      "header": {
        "$type": "dimension",
        "$value": "5rem",
        "$description": "Hauteur de la barre principale collante ; sert aussi au scroll-padding (WCAG 2.4.11)"
      },
      "focus-ring": {
        "$type": "dimension",
        "$value": "3px"
      },
      "border-control": {
        "$type": "dimension",
        "$value": "1px",
        "$description": "Epaisseur du bord des boutons"
      }
    }
  },
  "dark": {
    "$description": "Surcharges semantiques du mode sombre",
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{primitive.night.950}"
      },
      "card": {
        "$type": "color",
        "$value": "{primitive.night.900}"
      },
      "band": {
        "$type": "color",
        "$value": "{primitive.night.925}"
      },
      "deep": {
        "$type": "color",
        "$value": "{primitive.rouge.dark}"
      },
      "deeper": {
        "$type": "color",
        "$value": "{primitive.night.1000}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.night.100}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.night.300}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.night.400}"
      },
      "link": {
        "$type": "color",
        "$value": "{primitive.gold.400}"
      },
      "accent": {
        "$type": "color",
        "$value": "{primitive.gold.400}"
      },
      "on-action": {
        "$type": "color",
        "$value": "{primitive.rouge.975}"
      },
      "on-deep": {
        "$type": "color",
        "$value": "{primitive.night.100}"
      },
      "on-deep-muted": {
        "$type": "color",
        "$value": "{primitive.rouge.100}"
      },
      "ornament": {
        "$type": "color",
        "$value": "{primitive.gold.400}"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.gold.400}"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{primitive.gold.300}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{primitive.night.800}"
      },
      "strong": {
        "$type": "color",
        "$value": "{primitive.night.500}"
      }
    },
    "feedback": {
      "error-text": {
        "$type": "color",
        "$value": "{primitive.danger.300}"
      },
      "success-text": {
        "$type": "color",
        "$value": "{primitive.success.300}"
      }
    }
  }
}
