        "$value": "{primitive.night.100}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.night.300}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.night.400}"
      },
      "link": {
        "$type": "color",
        "$value": "{primitive.gold.400}"
      },
      "accent": {
        "$type": "color",
        "$value": "{primitive.gold.400}"
      },
      "on-action": {
        "$type": "color",
        "$value": "{primitive.navy.950}"
      },
      "on-deep": {
        "$type": "color",
        "$value": "{primitive.night.100}"
      },
      "on-deep-muted": {
        "$type": "color",
        "$value": "{primitive.navy.200}"
      },
      "ornament": {
        "$type": "color",
        "$value": "{primitive.gold.400}"
      }
    },
    "action": {
