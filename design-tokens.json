{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Source unique du theme du site. Primitive -> semantic -> dark. scripts/build-tokens.mjs genere src/tokens.css a partir de ce fichier ; ne jamais editer tokens.css a la main. Direction : blanc franc, noir d'encre, vert zellige profond pour les bandeaux, terracotta vif pour l'action. Aucun ton pastel.",
  "primitive": {
    "neutral": {
      "0": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "50": {
        "$type": "color",
        "$value": "#F5F4F1"
      },
      "150": {
        "$type": "color",
        "$value": "#E4E1DA"
      },
      "500": {
        "$type": "color",
        "$value": "#77716A"
      },
      "600": {
        "$type": "color",
        "$value": "#6B665E"
      },
      "750": {
        "$type": "color",
        "$value": "#3F3B36"
      },
      "950": {
        "$type": "color",
        "$value": "#141414"
      }
    },
    "night": {
      "950": {
        "$type": "color",
        "$value": "#101010"
      },
      "925": {
        "$type": "color",
        "$value": "#171717"
      },
      "900": {
        "$type": "color",
        "$value": "#1B1B1B"
      },
      "800": {
        "$type": "color",
        "$value": "#34312D"
      },
      "500": {
        "$type": "color",
        "$value": "#8C867D"
      },
      "400": {
        "$type": "color",
        "$value": "#9D978D"
      },
      "300": {
        "$type": "color",
        "$value": "#C9C4BB"
      },
      "100": {
        "$type": "color",
        "$value": "#F4F2EE"
      }
    },
    "terracotta": {
      "600": {
        "$type": "color",
        "$value": "#B23A1A"
      },
      "650": {
        "$type": "color",
        "$value": "#A1341A"
      },
      "700": {
        "$type": "color",
        "$value": "#932F14"
      },
      "400": {
        "$type": "color",
        "$value": "#E8734E"
      },
      "350": {
        "$type": "color",
        "$value": "#F08A68"
      },
      "300": {
        "$type": "color",
        "$value": "#F29A78"
      }
    },
    "zellige": {
      "900": {
        "$type": "color",
        "$value": "#0F3B31"
      },
      "950": {
        "$type": "color",
        "$value": "#0A2922"
      },
      "200": {
        "$type": "color",
        "$value": "#C5D3CE"
      }
    },
    "gold": {
      "400": {
        "$type": "color",
        "$value": "#D8B45C"
      }
    },
    "danger": {
      "700": {
        "$type": "color",
        "$value": "#A12622"
      },
      "300": {
        "$type": "color",
        "$value": "#F2A39B"
      }
    },
    "success": {
      "700": {
        "$type": "color",
        "$value": "#2F6246"
      },
      "300": {
        "$type": "color",
        "$value": "#9ED0B2"
      }
    }
  },
  "semantic": {
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{primitive.neutral.0}",
        "$description": "Fond de page, blanc franc"
      },
      "card": {
        "$type": "color",
        "$value": "{primitive.neutral.0}",
        "$description": "Cartes et formulaire"
      },
      "band": {
        "$type": "color",
        "$value": "{primitive.neutral.50}",
        "$description": "Bandeau neutre discret (rare)"
      },
      "deep": {
        "$type": "color",
        "$value": "{primitive.zellige.900}",
        "$description": "Bandeaux forts et pied de page, vert zellige profond"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.neutral.950}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.neutral.750}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.neutral.600}",
        "$description": "Metadonnees uniquement"
      },
      "link": {
        "$type": "color",
        "$value": "{primitive.terracotta.650}"
      },
      "on-action": {
        "$type": "color",
        "$value": "{primitive.neutral.0}"
      },
      "on-deep": {
        "$type": "color",
        "$value": "{primitive.neutral.0}"
      },
      "on-deep-muted": {
        "$type": "color",
        "$value": "{primitive.zellige.200}"
      },
      "ornament": {
        "$type": "color",
        "$value": "{primitive.gold.400}",
        "$description": "Accent sur fond fonce uniquement"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.terracotta.600}"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{primitive.terracotta.700}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{primitive.neutral.150}",
        "$description": "Decoratif : separateurs, bords de carte"
      },
      "strong": {
        "$type": "color",
        "$value": "{primitive.neutral.500}",
        "$description": "Bord essentiel des champs et boutons secondaires (>= 3:1)"
      }
    },
    "feedback": {
      "error-text": {
        "$type": "color",
        "$value": "{primitive.danger.700}"
      },
      "success-text": {
        "$type": "color",
        "$value": "{primitive.success.700}"
      }
    }
  },
  "system": {
    "$description": "Tokens non colores, emis tels quels en variables CSS (--radius-*, --shadow-*, --duration-*, --ease-*, --size-*)",
    "radius": {
      "frame": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Photos et tuiles"
      },
      "control": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Boutons, champs"
      },
      "card": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Panneaux et formulaire"
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$description": "Etiquettes"
      }
    },
    "shadow": {
      "raised": {
        "$type": "shadow",
        "$value": "0 2px 12px rgb(20 20 20 / 0.08)"
      },
      "overlay": {
        "$type": "shadow",
        "$value": "0 12px 40px rgb(20 20 20 / 0.18)"
      }
    },
    "scrim": {
      "photo": {
        "$type": "gradient",
        "$value": "linear-gradient(to top, rgb(10 10 10 / 0.82) 0%, rgb(10 10 10 / 0.35) 45%, rgb(10 10 10 / 0) 75%)",
        "$description": "Voile sous le texte pose sur une photo (lisibilite >= 4.5:1)"
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "220ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms",
        "$description": "Zoom doux des photos au survol"
      },
      "spin": {
        "$type": "duration",
        "$value": "800ms",
        "$description": "Rotation de l'indicateur de chargement"
      }
    },
    "ease": {
      "out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "in-out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
      }
    },
    "size": {
      "header": {
        "$type": "dimension",
        "$value": "4.5rem",
        "$description": "Hauteur du header collant ; sert aussi au scroll-padding (WCAG 2.4.11)"
      },
      "focus-ring": {
        "$type": "dimension",
        "$value": "3px"
      },
      "border-control": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Epaisseur du bord des boutons (lisible, 3:1 garanti par la couleur)"
      }
    }
  },
  "dark": {
    "$description": "Surcharges semantiques du mode sombre",
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{primitive.night.950}"
      },
      "card": {
        "$type": "color",
        "$value": "{primitive.night.900}"
      },
      "band": {
        "$type": "color",
        "$value": "{primitive.night.925}"
      },
      "deep": {
        "$type": "color",
        "$value": "{primitive.zellige.950}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.night.100}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.night.300}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.night.400}"
      },
      "link": {
        "$type": "color",
        "$value": "{primitive.terracotta.300}"
      },
      "on-action": {
        "$type": "color",
        "$value": "{primitive.neutral.950}"
      },
      "on-deep": {
        "$type": "color",
        "$value": "{primitive.night.100}"
      },
      "on-deep-muted": {
        "$type": "color",
        "$value": "{primitive.zellige.200}"
      },
      "ornament": {
        "$type": "color",
        "$value": "{primitive.gold.400}"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.terracotta.400}"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{primitive.terracotta.350}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{primitive.night.800}"
      },
      "strong": {
        "$type": "color",
        "$value": "{primitive.night.500}"
      }
    },
    "feedback": {
      "error-text": {
        "$type": "color",
        "$value": "{primitive.danger.300}"
      },
      "success-text": {
        "$type": "color",
        "$value": "{primitive.success.300}"
      }
    }
  }
}
