    "neutral": {
      "0": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "50": {
        "$type": "color",
        "$value": "#F6F3F0"
      },
      "150": {
        "$type": "color",
        "$value": "#E8E2DC"
      },
      "500": {
